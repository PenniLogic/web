# PenniLogic web environment schema. Copy to `.env` for local overrides.
# The schema is enforced at build time by src/env (see docs/development.md#environment).
# Empty values count as unset and fall back to the documented default.

# Browser-visible. Inlined into the client bundle at build time; never a secret.
# Allowed: local | preview | production. Default: local.
NEXT_PUBLIC_APP_ENV=local

# Server-only variables are declared in src/env/server-schema.ts. None are
# required yet. Any other NEXT_PUBLIC_* variable fails the build until it is
# declared in src/env/client-schema.ts.
