{
  "name": "@pennilogic/web",
  "version": "0.1.0",
  "private": true,
  "description": "PenniLogic customer web application",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "cross-env NEXT_TELEMETRY_DISABLED=1 next dev",
    "build": "cross-env NEXT_TELEMETRY_DISABLED=1 node tools/timed.ts build -- next build",
    "start": "cross-env NEXT_TELEMETRY_DISABLED=1 next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "cross-env NEXT_TELEMETRY_DISABLED=1 next typegen && node tools/timed.ts type-check -- tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:bundle": "node tools/client-bundle-check.ts",
    "check:bundle:planted": "node tools/planted-secret-check.ts",
    "report:build": "node tools/build-report.ts",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build && npm run check:bundle && npm run report:build && npm run check:bundle:planted"
  },
  "dependencies": {
    "next": "16.3.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
